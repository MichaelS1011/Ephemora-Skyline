FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json .npmrc ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
# .npmrc (legacy-peer-deps) must be present for npm ci to accept the lockfile
RUN npm ci --ignore-scripts

COPY tsconfig.base.json ./
COPY frontend/ ./frontend/
# One frontend test reads the curated labels from the backend module itself
# (`tests/rule-chip-labels.test.ts`), and `tsc -b` type-checks tests too.
# Copying only frontend/ left that import unresolved in the image build.
COPY backend/src/ ./backend/src/

RUN npm run build --workspace=ephemora-skyline-frontend

FROM nginx:alpine

COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
