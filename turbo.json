{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV", "GITHUB_TOKEN", "DATABASE_URL", "REDIS_URL"],
  "globalPassThroughEnv": [
    "PORT",
    "HOST",
    "FRONTEND_ORIGIN",
    "BACKEND_PORT",
    "TRUST_PROXY",
    "SKYLINE_OFFLINE",
    "CODECITY_*",
    "ANALYSIS_*",
    "SEMGREP_*",
    "GITLEAKS_*",
    "OSV_TIMEOUT",
    "NPM_AUDIT_TIMEOUT",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "REQUESTS_CA_BUNDLE",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "TMPDIR",
    "TEMP",
    "TMP"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.json", "*.ts", "*.js"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "lint": {
      "cache": false
    },
    "type-check": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
