# CodeCity CyberDefense - Environment Variables
# Copy this file to .env and fill in your values.

# ── Backend ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# GitHub personal access token — required for private repos, recommended for
# higher API rate limits on public repos.
GITHUB_TOKEN=

# Optional: Override frontend origin for CORS (defaults to http://localhost:3010 — Vite dev server)
FRONTEND_ORIGIN=http://localhost:3010

# Optional: Clone manager tuning
# Maximum age (ms) before a cached clone is evicted (default: 86400000 = 24h)
CLONE_MAX_AGE=86400000
# Maximum total disk space (MB) used by clones before cleanup (default: 2048)
CLONE_MAX_DISK_MB=2048
# Shallow-clone depth passed to git --depth (0 = full clone, default: 1)
GIT_CLONE_DEPTH=1
# Timeout in seconds for individual git commands (default: 120)
GIT_TIMEOUT=120

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# WebSocket URL for real-time analysis progress (defaults to ws://localhost:4000/ws)
VITE_WS_URL=ws://localhost:4000/ws
