# Ephemora Skyline — environment variables
#
# Every line here is read by the code today; the default in the comment is what
# the process uses when the variable is absent. Nothing in this file is required
# for a normal local run — copy it only when you want to change a default.

# ── Server ─────────────────────────────────────────────────────────────────
# Listen port (backend/src/server/index.ts:298)
PORT=4000
# Bind address. Loopback by default; set only on a network you own, because the
# API can run the tests of any folder it is handed and has no authentication
# (backend/src/server/bind-address.ts:18, and the warning the server logs itself
# at index.ts:302-307).
HOST=127.0.0.1
NODE_ENV=development

# Origins allowed to read responses and to send writes. The local-only guard
# parses this as a comma-separated list and always adds http://127.0.0.1:3010
# and tauri://localhost; CORS now answers the same list
# (backend/src/server/local-only.ts:39-73).
FRONTEND_ORIGIN=http://localhost:3010
# Set to 1 when the API sits behind a reverse proxy, so rate limits key on the
# client address in X-Forwarded-For rather than the proxy's
# (backend/src/server/index.ts:142).
TRUST_PROXY=

# ── Outbound calls ─────────────────────────────────────────────────────────
# 1 stops every call that leaves the machine: semgrep rule fetches, OSV and npm
# advisory lookups, gitleaks' release check and the app's own update check.
# Engines that need data they may not fetch report themselves as skipped
# (backend/src/services/security/network-policy.ts:13).
SKYLINE_OFFLINE=

# ── Scanner engines ────────────────────────────────────────────────────────
# Without the gitleaks / semgrep / osv-scanner / ruff binaries on PATH the
# matching checks report skipped — they never pretend to have run.
# semgrep registry config, or a local rules dir for offline runs
SEMGREP_CONFIG=p/security-audit
# semgrep container image used when no semgrep binary is installed
SEMGREP_DOCKER_IMAGE=semgrep/semgrep:1.162.0
# Seconds for a whole-repo semgrep run (default 120)
SEMGREP_TIMEOUT=120
# Seconds for the whole-repo gitleaks run (default 120)
GITLEAKS_TIMEOUT=120
# Seconds for the osv-scanner lookup (default 120)
OSV_TIMEOUT=120
# Seconds for the npm audit lookup (default 90)
NPM_AUDIT_TIMEOUT=90

# ── Staged copies of the chosen folder ─────────────────────────────────────
# Where the source copy a scan works on is staged (default $TMPDIR/codecity-uploads)
CODECITY_UPLOAD_DIR=
# Hours a staged copy survives; swept at startup and every 6 hours (default 24)
CODECITY_UPLOAD_TTL_HOURS=24

# ── In-memory result store ─────────────────────────────────────────────────
# Results are not written to disk; this is the RAM cache the UI reads
# (backend/src/server/index.ts:51-60)
ANALYSIS_MAX_ENTRIES=20
# Milliseconds a result lives before it is dropped (default 86400000 = 24 h)
ANALYSIS_TTL_MS=86400000

# ── Rule packs ─────────────────────────────────────────────────────────────
# Bundled pack directory, shipped with the app (default backend/rules)
CODECITY_RULES_DIR=
# Directory for packs the user installed themselves (default ~/.ephemora-skyline/rule-packs)
CODECITY_RULE_PACK_DIR=

# The frontend reads no environment variables of its own: it talks to the
# loopback port it was served from.
