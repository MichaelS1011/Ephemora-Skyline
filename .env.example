# CodeCity CyberDefense - Environment Variables
# Copy this file to .env and fill in your values.

# ── Backend ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# GitHub personal access token — required for private repos, recommended for
# higher API rate limits on public repos. Passed to git via a temp askpass
# helper, never on the command line.
GITHUB_TOKEN=

# Optional: Override frontend origin for CORS (defaults to http://localhost:3010 — Vite dev server)
FRONTEND_ORIGIN=http://localhost:3010

# Optional: Clone behavior
# Shallow-clone depth passed to git --depth (0 = full clone, default: 1)
GIT_CLONE_DEPTH=1
# Timeout in seconds for git clone (default: 120)
GIT_TIMEOUT=120

# Optional: Scanner behavior (without gitleaks/semgrep binaries the scan
# silently degrades to regex-only — see docs/GETTING_STARTED.md)
# Registry config for semgrep, or a local rules dir for offline runs (default: p/security-audit)
SEMGREP_CONFIG=p/security-audit
# Pinned semgrep docker image used when the semgrep binary is not installed
SEMGREP_DOCKER_IMAGE=semgrep/semgrep:1.162.0
# Timeout in seconds for a whole-repo semgrep run (default: 120)
SEMGREP_TIMEOUT=120
# Timeout in seconds for the whole-repo gitleaks run (default: 120)
GITLEAKS_TIMEOUT=120

# Optional: In-memory analysis store bounds
# Maximum number of stored results before oldest is evicted (default: 20)
ANALYSIS_MAX_ENTRIES=20
# Time-to-live in ms for stored results (default: 86400000 = 24h)
ANALYSIS_TTL_MS=86400000

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# WebSocket URL for real-time analysis progress (defaults to ws://localhost:4000/ws)
VITE_WS_URL=ws://localhost:4000/ws
