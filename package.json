{
  "name": "codecity-cyberdefense",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "npm@10.0.0",
  "description": "3D city visualizer for local codebases \u2014 folders rise as districts, security findings glow as beacons",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelS1011/Ephemora-Skyline.git"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run build --silent && node scripts/ephemora-skyline.mjs",
    "package:build": "node scripts/package-stage.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "rm -rf */dist .turbo node_modules */node_modules",
    "format": "prettier --write \"{frontend,backend}/{src,tests}/**/*.{ts,tsx,json}\"",
    "prepare": "husky install"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "braces": "^3.0.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
