{
  "name": "ephemora-skyline",
  "version": "0.4.7",
  "description": "Your local codebase as a 3D city — folders as districts, files as buildings, findings as beacons. Nothing leaves your machine.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ephemora-skyline": "scripts/ephemora-skyline.mjs"
  },
  "files": [
    "scripts/ephemora-skyline.mjs",
    "backend/dist",
    "frontend/dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "docs/*.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelS1011/Ephemora-Skyline.git"
  },
  "bugs": {
    "url": "https://github.com/MichaelS1011/Ephemora-Skyline/issues"
  },
  "homepage": "https://github.com/MichaelS1011/Ephemora-Skyline#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "pino": "^9.14.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "pack:check": "node scripts/pack-check.mjs"
  },
  "keywords": ["code-visualization", "static-analysis", "security", "local-first", "3d"]
}
